# Copy this file to .env and adjust as needed.

# Defaults to a local SQLite file if not set — works with zero setup.
# To use MySQL instead, install pymysql (see requirements.txt) and set:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/stocksense
DATABASE_URL=sqlite:///./stocksense.db

SECRET_KEY=change-this-to-a-long-random-string-in-production

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
